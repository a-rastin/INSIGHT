net
{
    name = "AcuteDystoniaAnticholinergicManagement";
    comment = "Qualitative Bayesian Network revised for explicit intervention priority nodes. Placeholder CPTs require clinical calibration before use.";
}

node CurrentAcuteDystoniaLikelihood
{
    label = "Likelihood of current acute dystonia associated with antipsychotic therapy";
    states = ("Likely" "Possible" "UnlikelyOrAbsent" "Unknown");
    comment = "Source basis: DSM-5 acute dystonia definition and APA Statement 11. This replaces the prior EpisodeStatus node to avoid post-treatment leakage.";
}

node AirwayLaryngealInvolvement
{
    label = "Airway or laryngeal involvement";
    states = ("Present" "Absent" "Unknown");
    comment = "Captures laryngospasm or inability to breathe. Unknown airway status should drive assessment, not presumptive IV treatment.";
}

node PostAcuteEpisodeResolved
{
    label = "Whether the acute dystonic episode has resolved after acute treatment";
    states = ("Yes" "No" "Unknown");
    comment = "Separate post-acute state used only for continuation and regimen-adjustment decisions.";
}

node AnticholinergicHarmVulnerability
{
    label = "Vulnerability to anticholinergic harms";
    states = ("High" "NotHigh" "Unknown");
    comment = "Includes older age, cognitive risk, urinary retention, constipation/fecal impaction, glaucoma risk, thermoregulation risk, and cumulative anticholinergic burden.";
}

node PriorAnticholinergicIntolerance
{
    label = "Prior intolerance or clinically important adverse reaction to anticholinergic exposure";
    states = ("Present" "Absent" "Unknown");
    comment = "Separated from patient preference because intolerance is a clinical risk fact, not a preference state.";
}

node PatientPreferenceForAnticholinergic
{
    label = "Patient preference for anticholinergic medication";
    states = ("Accepts" "Declines" "Unknown");
    comment = "Patients often accept acute treatment but may decline ongoing exposure because of adverse effects.";
}

node RecurrenceRiskContext
{
    label = "Risk context for recurrent acute dystonia";
    states = ("Elevated" "NotElevated" "Unknown");
    comment = "Elevated risk includes high-potency FGA, high dose, IM route, young age, male sex, ethnicity-associated risk, recent cocaine use, or prior EPS history where available.";
}

node AnticholinergicUseConstraint
{
    label = "Combined preference, intolerance, and harm constraint for anticholinergic exposure";
    states = ("AcceptableShortTerm" "UseWithCaution" "AvoidIfPossible" "Unknown");
    comment = "Mediates patient preference, prior intolerance, and harm vulnerability into acute and continuation priorities.";
}

node EmergentAirwayIVTreatmentPriority
{
    label = "Priority of emergent IV anticholinergic treatment with airway support";
    states = ("High" "NotIndicated" "Unknown");
    comment = "Rationale label: LARYNGOSPASM_EMERGENT_IV. Fires primarily when airway or laryngeal involvement is present.";
}

node AcuteParenteralAnticholinergicPriority
{
    label = "Priority of acute parenteral anticholinergic or antihistaminic treatment";
    states = ("High" "Moderate" "Low" "NotIndicated" "Unknown");
    comment = "Rationale labels: APA_1C_TREAT_ACUTE_DYSTONIA and IM_DIPHENHYDRAMINE_OR_BENZTROPINE. Harm vulnerability tempers non-emergent acute treatment without blocking laryngospasm management.";
}

node OralContinuationPriority
{
    label = "Priority of short-term oral anticholinergic continuation after resolution";
    states = ("ContinueShortTerm" "ConsiderShortTerm" "MinimizeOrAvoid" "NotIndicated" "Unknown");
    comment = "Rationale labels: POST_RESOLUTION_PREVENT_RECURRENCE and LOWEST_DOSE_SHORTEST_TIME.";
}

node AntipsychoticRegimenAdjustmentPriority
{
    label = "Priority of antipsychotic dose reduction or switch to lower dystonia-risk medication";
    states = ("Prioritize" "Consider" "NotIndicated" "Unknown");
    comment = "Represents dose reduction or switch to an antipsychotic less likely to cause acute dystonia.";
}

node ManagementRecommendation
{
    label = "Final ranked management recommendation";
    states = ("EmergentIVAnticholinergicPlusAirwaySupport" "PromptParenteralAnticholinergicTreatment" "TreatSuspectedDystoniaAndReassess" "ShortTermOralAnticholinergicContinuation" "AntipsychoticDoseReductionOrSwitch" "MinimizeAnticholinergicAndSeekExpertReview" "NoAnticholinergicTreatmentCurrentlyIndicated" "InsufficientInformationAssessEpisodeAirwayRisks");
    comment = "Clinical action pattern output. Not an automatic order trigger or quality measure.";
}

potential (CurrentAcuteDystoniaLikelihood)
{
    data = (0.250000 0.250000 0.250000 0.250000);
}

potential (AirwayLaryngealInvolvement)
{
    data = (0.333333 0.333333 0.333333);
}

