      <PROPERTY>Effective outpatient commitment implementation requires adequate resources and individualized treatment planning.</PROPERTY>
    </VARIABLE>

    <VARIABLE TYPE="nature">
      <NAME>immediate_treatment_path</NAME>
      <OUTCOME>continue_voluntary_collaborative_treatment</OUTCOME>
      <OUTCOME>follow_advance_directive_and_reassess</OUTCOME>
