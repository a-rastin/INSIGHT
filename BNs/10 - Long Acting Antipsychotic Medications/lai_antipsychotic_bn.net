net
{
  name = "LAI_Antipsychotic_CDS_BN";
  node_size = (120 45);
}

node DiagnosisStatus
{
  label = "Schizophrenia or schizoaffective diagnosis";
  states = ("present" "absent" "uncertain");
}

node AntipsychoticIndicated
{
  label = "Ongoing antipsychotic treatment indicated";
  states = ("yes" "no" "uncertain");
}

node PatientPrefersLAI
{
  label = "Patient preference for long-acting injectable antipsychotic";
  states = ("yes" "no" "unknown");
}

node PriorPositiveLAIExperience
{
  label = "Prior positive experience with LAI antipsychotic";
  states = ("yes" "no" "none_or_unknown");
}

node OralAdherence
{
  label = "Current adherence to oral antipsychotic treatment";
  states = ("good" "poor" "uncertain");
}

node LimitedIllnessInsight
{
  label = "Limited awareness of need for treatment";
  states = ("yes" "no" "unknown");
}

node SubstanceUseDisorder
{
  label = "Co-occurring substance use disorder";
  states = ("yes" "no" "unknown");
}

node CareTransition
{
  label = "Transition between care settings or release from supervised setting";
  states = ("yes" "no");
}

node RepeatedHospitalOrED
{
  label = "Repeated psychiatric hospitalization or emergency visits";
  states = ("yes" "no");
}

node PoorOralResponse
{
  label = "Poor or partial response to oral antipsychotic";
  states = ("yes" "no" "unclear");
}

node SuspectedUnrecognizedNonadherence
{
  label = "Suspected unrecognized nonadherence despite prescribed oral treatment";
  states = ("likely" "possible" "unlikely");
}

node AdherenceRisk
{
  label = "Prospective risk of poor adherence";
  states = ("high" "moderate" "low");
}

node PreferenceIndication
{
  label = "LAI indication strength from patient preference";
  states = ("strong" "moderate" "weak" "none");
}

node AdherenceIndication
{
  label = "LAI indication strength from adherence history and risk";
  states = ("strong" "moderate" "weak" "none");
}

node UtilizationIndication
{
  label = "LAI indication strength from utilization, transition, or hidden nonadherence";
  states = ("strong" "moderate" "weak" "none");
}

node LAIIndicationStrength
{
  label = "Overall clinical indication strength for LAI antipsychotic";
  states = ("strong" "moderate" "weak" "none");
}

node OralFormulationTolerated
{
  label = "Oral formulation of candidate antipsychotic tolerated";
  states = ("yes" "no" "not_tried");
}

node PriorResponseCandidateAntipsychotic
{
  label = "Prior therapeutic response to candidate antipsychotic";
  states = ("good" "partial" "poor" "unknown");
}

node PriorNMS
{
  label = "Prior neuroleptic malignant syndrome";
  states = ("yes" "no" "unknown");
}

node InjectionAcceptability
{
  label = "Acceptability of receiving injections";
  states = ("accepts" "reluctant" "refuses" "unknown");
}

node LAIFormulationAvailable
{
  label = "LAI formulation availability for current or candidate medication";
  states = ("yes_same_drug" "yes_switch_needed" "no");
}

node DrugTolerabilityStatus
{
  label = "Medication tolerability status for LAI use";
  states = ("suitable" "caution" "unsuitable");
}

node PracticalAcceptability
{
  label = "Practical acceptability of LAI route and formulation";
  states = ("suitable" "caution" "unsuitable");
}

node LAISafetySuitability
{
  label = "Overall LAI safety and suitability";
  states = ("suitable" "caution" "unsuitable");
}

node CostInsuranceBarrier
{
  label = "Cost or insurance authorization barrier";
  states = ("none" "manageable" "major");
}

node TransportScheduleBarrier
{
  label = "Transport, schedule, childcare, school, or work barrier";
  states = ("none" "manageable" "major");
}

node AdministrationFeasibility
{
  label = "Clinic or partner capacity to administer LAI safely";
  states = ("feasible" "feasible_with_support" "not_feasible");
}

node ImplementationBarriers
{
  label = "Overall implementation barriers";
  states = ("low" "moderate" "high");
}

node ExpectedBenefitFromLAI
{
  label = "Expected clinical benefit from LAI treatment";
  states = ("high" "moderate" "low");
}

node ExpectedHarmBurdenFromLAI
{
  label = "Expected harm or burden from LAI treatment";
  states = ("high" "moderate" "low");
}

node NetClinicalFavorability
{
  label = "Net clinical favorability of LAI treatment";
  states = ("favorable" "conditional" "unfavorable");
}

node LAIRecommendation
{
  label = "CDS recommendation for long-acting injectable antipsychotic";
  states = ("recommend_lai" "offer_shared_decision" "consider_with_barrier_mitigation" "defer_lai" "avoid_or_specialist_review");
}

